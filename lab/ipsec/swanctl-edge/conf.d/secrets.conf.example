# Template — gere segredos novos localmente (PSK via `openssl rand -base64
# 32`, PPK via `openssl rand -hex 32`) e salve como
# /etc/swanctl/conf.d/secrets.conf real (root:root, 600) em cada lado
# (cu-ns e 5gc-edge-ns, mesmo valor nos dois). O arquivo de verdade não é
# versionado (ver .gitignore). O ppk-urllc simula o material QKD injetado
# na fatia URLLC (RFC 8784) — ver ARQUITETURA-PROTOTIPO-COMPLETA.md seção
# 5.3.
secrets {
    ike-n3-urllc {
        id-1 = 10.97.0.11
        id-2 = 10.97.0.12
        secret = "TROQUE_ESTE_PSK_N3_URLLC"
    }
    ike-n3-embb {
        id-1 = 10.97.0.21
        id-2 = 10.97.0.22
        secret = "TROQUE_ESTE_PSK_N3_EMBB"
    }
    ike-n3-miot {
        id-1 = 10.97.0.31
        id-2 = 10.97.0.32
        secret = "TROQUE_ESTE_PSK_N3_MIOT"
    }
    ppk-urllc {
        id = ppk-urllc-qkd
        secret = 0xTROQUE_ESTE_PPK_HEX_SIMULANDO_QKD
    }
}
